{
  "name": "localhand",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @localhand/shared build && pnpm --parallel --filter @localhand/web --filter @localhand/api dev",
    "dev:web": "pnpm --filter @localhand/web dev",
    "dev:api": "pnpm --filter @localhand/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @localhand/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @localhand/shared build && pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm openspec:validate",
    "openspec:validate": "openspec validate --all --strict",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:generate": "pnpm --filter @localhand/api db:generate",
    "db:migrate": "pnpm --filter @localhand/api db:migrate",
    "db:seed": "pnpm --filter @localhand/api db:seed",
    "preview": "pnpm --filter @localhand/web preview",
    "storybook": "pnpm --filter @localhand/web storybook"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.9",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
