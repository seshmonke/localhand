# Local Hand — локальная разработка.
# Скопировать в .env и заполнить. Секреты в репозиторий не коммитить.

NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL из docker-compose.yml
DATABASE_URL=postgres://localhand:localhand@localhost:5433/localhand

# Отдельная БД для DB-тестов auth; без неё эти тесты пропускаются.
# DATABASE_URL_TEST=postgres://localhand:localhand@localhost:5433/localhand_test

# Сессия и OTP: обязательны вне NODE_ENV=test.
# Сгенерировать: openssl rand -base64 48
# Плейсхолдеры change-me / dev-only / ci-only / localhand-dev- отклоняются.
JWT_SECRET=
OTP_SECRET=

# SMS: dev — только вне production; smsru требует SMSRU_API_ID.
SMS_PROVIDER=dev
SMSRU_API_ID=

# Платежи (S3-1). Провайдер не задан — платежи выключены.
# PAYMENTS_PROVIDER=fake|yookassa
# PAYMENTS_ENV=live|sandbox|test, по умолчанию live.
# PAYMENTS_FAKE_ENABLED=true разрешён только вне live и только с fake.
# PAYMENTS_STATE_SECRET — случайная строка ≥32 символов (HMAC state).
# PAYMENTS_TOKEN_KEYS — JSON {"1":"base64-32-byte-key"}; ключи не коммитить.
# PAYMENTS_TOKEN_KEY_VERSION — активная версия из keyring.
# YOOKASSA_REDIRECT_URI — зарегистрированный callback, обязателен для yookassa;
# в PAYMENTS_ENV=live только https (http разрешён для localhost и sandbox/test).
# PAYMENTS_PROVIDER=fake
# PAYMENTS_ENV=sandbox
# PAYMENTS_FAKE_ENABLED=true
# PAYMENTS_STATE_SECRET=
# PAYMENTS_TOKEN_KEYS=
# PAYMENTS_TOKEN_KEY_VERSION=1
# YOOKASSA_REDIRECT_URI=

# Доверять X-Forwarded-For только Caddy: его IP/CIDR, не true.
# В production обязателен явный адрес, иначе API не стартует.
# Можно список через запятую, например:
# TRUST_PROXY=172.28.0.2/32

# S3 (Selectel Object Storage)
S3_ENDPOINT=https://s3.storage.selcloud.ru
S3_REGION=ru-1
S3_BUCKET=localhand-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGNED_GET_TTL_SECONDS=3600

# LLM (Selectel Token Factory)
LLM_BASE_URL=https://api.tf.selcloud.ru/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash-1017
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_MS=60000
